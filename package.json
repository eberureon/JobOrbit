{
	"name": "joborbit",
	"private": true,
	"type": "module",
	"imports": {
		"~/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 9000",
		"build": "vite build",
		"start": "srvx --prod -s ../client dist/server/server.js",
		"preview": "vite preview",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepare": "if command -v husky; then husky; fi"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@hookform/resolvers": "^5.9.1",
		"@internationalized/date": "^3.12.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/match-sorter-utils": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "^1.168.45",
		"@tanstack/start-server-core": "^1.169.42",
		"better-sqlite3": "^12.11.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"lucide-react": "^1.57.0",
		"papaparse": "^5.7.0",
		"react": "^19.3.0",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.90.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"remark-gfm": "^4.0.1",
		"srvx": "0.11.16",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/types": "^21.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.20.5",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.88.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
		"*": "bun fmt --no-error-on-unmatched-pattern"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
